    areaGradient.Rotation = 90
    areaGradient.Parent = areaJogo

    local areaStroke = Instance.new("UIStroke")
    areaStroke.Color = Color3.fromRGB(120, 200, 255)
    areaStroke.Thickness = 3
    areaStroke.Parent = areaJogo

    -- cabeçalho (instrução + placares) fica FORA da área que corta o conteúdo,
    -- senão os textos ficariam invisíveis (a área do jogo corta tudo que passa da borda)
