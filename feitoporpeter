    instrucaoFrutas.Font = Enum.Font.GothamMedium
    instrucaoFrutas.TextWrapped = true
    instrucaoFrutas.TextScaled = true
    instrucaoFrutas.ZIndex = 3
    instrucaoFrutas.Parent = guiFrutas

    local placarLabel = Instance.new("TextLabel")
    placarLabel.Size = UDim2.new(0, PLAY_W, 0, 44)
    placarLabel.Position = UDim2.new(0.5, 0, 0, 50)
    placarLabel.AnchorPoint = Vector2.new(0.5, 0)
    placarLabel.BackgroundTransparency = 1
    placarLabel.Text = "🍓 0 / " .. META_FRUTAS
    placarLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    placarLabel.Font = Enum.Font.GothamBlack
    placarLabel.TextScaled = true
    placarLabel.ZIndex = 3
    placarLabel.Parent = guiFrutas

    -- contador que NÃO zera com erro, só soma toda fruta pega
    local contadorLabel = Instance.new("TextLabel")
    contadorLabel.Size = UDim2.new(0, PLAY_W, 0, 28)
    contadorLabel.Position = UDim2.new(0.5, 0, 0, 98)
    contadorLabel.AnchorPoint = Vector2.new(0.5, 0)
    contadorLabel.BackgroundTransparency = 1
    contadorLabel.Text = "Frutas pegas no total: 0"
    contadorLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
    contadorLabel.Font = Enum.Font.GothamBold
    contadorLabel.TextScaled = true
    contadorLabel.ZIndex = 3
    contadorLabel.Parent = guiFrutas

    -- boneco (player)
    local bonecoSize = 56
    local bonecoX = PLAY_W / 2
    local bonecoY = PLAY_H - 70

    local boneco = Instance.new("Frame")
    boneco.Name = "Boneco"
    boneco.Size = UDim2.new(0, bonecoSize, 0, bonecoSize)
    boneco.AnchorPoint = Vector2.new(0.5, 0.5)
    boneco.Position = UDim2.new(0, bonecoX, 0, bonecoY)
    boneco.BackgroundColor3 = Color3.fromRGB(255, 210, 120)
    boneco.BorderSizePixel = 0
    boneco.ZIndex = 4
    boneco.Parent = areaJogo

    local bonecoCorner = Instance.new("UICorner")
