    bonecoFace.Size = UDim2.new(1, 0, 1, 0)
    bonecoFace.BackgroundTransparency = 1
    bonecoFace.Text = "🙂"
    bonecoFace.TextScaled = true
    bonecoFace.ZIndex = 4
    bonecoFace.Parent = boneco

    -- sons (uma instância de cada, reaproveitada a cada acerto/erro)
    local somFruta = Instance.new("Sound")
    somFruta.Name = "SomFruta"
    somFruta.SoundId = SOM_FRUTA_ID
    somFruta.Volume = 1
    somFruta.Parent = SoundService

    local somErro = Instance.new("Sound")
    somErro.Name = "SomErro"
    somErro.SoundId = SOM_ERRO_ID
    somErro.Volume = 1
    somErro.Parent = SoundService

    guiFrutas.Destroying:Connect(function()
        somFruta:Destroy()
        somErro:Destroy()
    end)

    -- controles
    local teclasF = {w = false, a = false, s = false, d = false, up = false, left = false, down = false, right = false}

    local function mapKeyF(keyCode)
        if keyCode == Enum.KeyCode.W then return "w"
        elseif keyCode == Enum.KeyCode.A then return "a"
        elseif keyCode == Enum.KeyCode.S then return "s"
        elseif keyCode == Enum.KeyCode.D then return "d"
        elseif keyCode == Enum.KeyCode.Up then return "up"
        elseif keyCode == Enum.KeyCode.Left then return "left"
        elseif keyCode == Enum.KeyCode.Down then return "down"
        elseif keyCode == Enum.KeyCode.Right then return "right"
        end
        return nil
    end

    local conInputBeganF = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        local k = mapKeyF(input.KeyCode)
        if k then teclasF[k] = true end
    end)

    local conInputEndedF = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        local k = mapKeyF(input.KeyCode)
        if k then teclasF[k] = false end
    end)

    local velocidadeBoneco = 260

    -- pontuação
    local pontos = 0
    local totalPego = 0
    local jogoConcluido = false

    local function atualizarPlacar()
        placarLabel.Text = "🍓 " .. pontos .. " / " .. META_FRUTAS
        contadorLabel.Text = "Frutas pegas no total: " .. totalPego
    end

    local function penalidade()
        somErro.TimePosition = 0
        somErro:Play()
        pontos = 0
        atualizarPlacar()
        TweenService:Create(placarLabel, TweenInfo.new(0.1), {TextColor3 = Color3.fromRGB(255, 80, 80)}):Play()
        task.delay(0.3, function()
            if placarLabel.Parent then
                TweenService:Create(placarLabel, TweenInfo.new(0.25), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            end
        end)
        task.spawn(function()
            shakeFrame(areaJogo, nil)
        end)
    end

    -- itens caindo (frutas e quadrados)
    local FRUTAS_EMOJIS = {"🍎", "🍌", "🍇", "🍓", "🍊", "🍉", "🍒", "🍑"}
    local itensAtivos = {}

    local function spawnItem()
        local ehFruta = math.random() < 0.75
        local tamanho = 40

        local item = Instance.new("Frame")
        item.Size = UDim2.new(0, tamanho, 0, tamanho)
        item.AnchorPoint = Vector2.new(0.5, 0.5)
        local xInicial = math.random(tamanho, PLAY_W - tamanho)
        item.Position = UDim2.new(0, xInicial, 0, -tamanho)
        item.BackgroundTransparency = 1
        item.ZIndex = 3
        item.Parent = areaJogo

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextScaled = true
        label.ZIndex = 3
        label.Parent = item

        if ehFruta then
            label.Text = FRUTAS_EMOJIS[math.random(1, #FRUTAS_EMOJIS)]
        else
            item.BackgroundTransparency = 0
            item.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 6)
            itemCorner.Parent = item
            label.Text = "☠️"
        end

        table.insert(itensAtivos, {
            instancia = item,
            x = xInicial,
            y = -tamanho,
            tamanho = tamanho,
            ehFruta = ehFruta,
            pego = false,
        })
    end

    local VELOCIDADE_QUEDA = 130 -- pixels por segundo (mais baixo = mais fácil de alcançar)
    local acumuladorSpawn = 0
    local proximoSpawn = 0.9

    local conHeartbeatF
    conHeartbeatF = RunService.Heartbeat:Connect(function(dt)
        if jogoConcluido then return end

        -- mover boneco (livre nos dois eixos dentro da área)
        local dx = 0
        if teclasF.a or teclasF.left then dx = dx - 1 end
        if teclasF.d or teclasF.right then dx = dx + 1 end
        local dy = 0
        if teclasF.w or teclasF.up then dy = dy - 1 end
        if teclasF.s or teclasF.down then dy = dy + 1 end

        if dx ~= 0 or dy ~= 0 then
            local comprimento = math.sqrt(dx * dx + dy * dy)
            dx = (dx / comprimento) * velocidadeBoneco * dt
            dy = (dy / comprimento) * velocidadeBoneco * dt
            bonecoX = math.clamp(bonecoX + dx, bonecoSize / 2, PLAY_W - bonecoSize / 2)
            bonecoY = math.clamp(bonecoY + dy, bonecoSize / 2, PLAY_H - bonecoSize / 2)
            boneco.Position = UDim2.new(0, bonecoX, 0, bonecoY)
        end

        -- spawna novos itens periodicamente
        acumuladorSpawn = acumuladorSpawn + dt
        if acumuladorSpawn >= proximoSpawn then
            acumuladorSpawn = 0
            proximoSpawn = math.random(80, 130) / 100 -- 0.8s a 1.3s entre cada item novo
            spawnItem()
        end

        -- move os itens e checa colisão com o boneco
        for i = #itensAtivos, 1, -1 do
            local it = itensAtivos[i]
            it.y = it.y + VELOCIDADE_QUEDA * dt
            it.instancia.Position = UDim2.new(0, it.x, 0, it.y)

            local metadeItem = it.tamanho / 2
            local metadeBoneco = bonecoSize / 2
            local colide = math.abs(it.x - bonecoX) < (metadeItem + metadeBoneco) * 0.9
                and math.abs(it.y - bonecoY) < (metadeItem + metadeBoneco) * 0.9

            if colide and not it.pego then
                it.pego = true
                it.instancia:Destroy()
                table.remove(itensAtivos, i)

                if it.ehFruta then
                    somFruta.TimePosition = 0
                    somFruta:Play()
                    pontos = pontos + 1
                    totalPego = totalPego + 1
                    atualizarPlacar()
                    if pontos >= META_FRUTAS then
                        jogoConcluido = true
                        conHeartbeatF:Disconnect()
                        conInputBeganF:Disconnect()
                        conInputEndedF:Disconnect()
                        for _, restante in ipairs(itensAtivos) do
                            if restante.instancia then
                                restante.instancia:Destroy()
                            end
                        end
                        guiFrutas:Destroy()
                        abrirPerguntaIdade()
                    end
                else
                    penalidade()
                end
            elseif it.y - metadeItem > PLAY_H then
                -- saiu da tela sem ser pego, some sem penalidade
                it.instancia:Destroy()
                table.remove(itensAtivos, i)
            end
        end
    end)
end

