    local paredes = {}
    local posInicio, posFim

    for linha = 1, #MAPA_LABIRINTO do
        local textoLinha = MAPA_LABIRINTO[linha]
        for coluna = 1, #textoLinha do
            local charAtual = textoLinha:sub(coluna, coluna)
            local x = (coluna - 1) * CELL_SIZE
            local y = (linha - 1) * CELL_SIZE

            if charAtual == "#" then
