                    ColorSequenceKeypoint.new(0, Color3.fromRGB(150, 40, 80)),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 20, 40)),
                })
                paredeGrad.Rotation = 90
                paredeGrad.Parent = parede

                table.insert(paredes, {x = x, y = y, size = CELL_SIZE})
            elseif charAtual == "S" then
                posInicio = {x = x, y = y}
            elseif charAtual == "E" then
                posFim = {x = x, y = y}
