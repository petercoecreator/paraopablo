    instrucaoFrutas.Size = UDim2.new(0, PLAY_W, 0, 34)
    instrucaoFrutas.Position = UDim2.new(0.5, 0, 0, 8)
    instrucaoFrutas.AnchorPoint = Vector2.new(0.5, 0)
    instrucaoFrutas.BackgroundTransparency = 1
    instrucaoFrutas.Text = "Use WASD ou as SETAS pra pegar as frutas 🍎 e desviar dos quadrados ☠️!"
