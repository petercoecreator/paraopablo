    -- Marcador do início (bem discreto)
    local marcadorInicio = Instance.new("Frame")
    marcadorInicio.Size = UDim2.new(0, CELL_SIZE, 0, CELL_SIZE)
    marcadorInicio.Position = UDim2.new(0, posInicio.x, 0, posInicio.y)
    marcadorInicio.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
    marcadorInicio.BackgroundTransparency = 0.5
    marcadorInicio.BorderSizePixel = 0
    marcadorInicio.ZIndex = 2
    marcadorInicio.Parent = mazeContainer

    -- Marcador do fim (verde, com ✅)
    local marcadorFim = Instance.new("Frame")
    marcadorFim.Size = UDim2.new(0, CELL_SIZE, 0, CELL_SIZE)
    marcadorFim.Position = UDim2.new(0, posFim.x, 0, posFim.y)
    marcadorFim.BackgroundColor3 = Color3.fromRGB(60, 220, 100)
    marcadorFim.BackgroundTransparency = 0.3
    marcadorFim.BorderSizePixel = 0
    marcadorFim.ZIndex = 2
    marcadorFim.Parent = mazeContainer

    local labelFim = Instance.new("TextLabel")
    labelFim.Size = UDim2.new(1, 0, 1, 0)
    labelFim.BackgroundTransparency = 1
    labelFim.Text = "✅"
    labelFim.TextScaled = true
    labelFim.ZIndex = 2
    labelFim.Parent = marcadorFim

    task.spawn(function()
        while rodandoLab and marcadorFim.Parent do
            local t1 = TweenService:Create(marcadorFim, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.7})
            t1:Play()
            t1.Completed:Wait()
            local t2 = TweenService:Create(marcadorFim, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.3})
            t2:Play()
            t2.Completed:Wait()
        end
    end)

    -- A minhoca (worm)
    local minhocaSize = CELL_SIZE * 0.7
    local minhoca = Instance.new("Frame")
    minhoca.Name = "Minhoca"
    minhoca.Size = UDim2.new(0, minhocaSize, 0, minhocaSize)
    minhoca.AnchorPoint = Vector2.new(0.5, 0.5)
    minhoca.Position = UDim2.new(0, posInicio.x + CELL_SIZE / 2, 0, posInicio.y + CELL_SIZE / 2)
    minhoca.BackgroundColor3 = Color3.fromRGB(150, 255, 120)
    minhoca.BorderSizePixel = 0
    minhoca.ZIndex = 4
    minhoca.Parent = mazeContainer

    local minhocaCorner = Instance.new("UICorner")
    minhocaCorner.CornerRadius = UDim.new(1, 0)
    minhocaCorner.Parent = minhoca

    local minhocaStroke = Instance.new("UIStroke")
    minhocaStroke.Color = Color3.fromRGB(40, 100, 30)
    minhocaStroke.Thickness = 2
    minhocaStroke.Parent = minhoca

    -- Posição real (em pixels, relativa ao canto superior esquerdo do mazeContainer)
    local posX = posInicio.x + CELL_SIZE / 2
    local posY = posInicio.y + CELL_SIZE / 2
    local velocidade = 160 -- pixels por segundo

    local teclas = {
        w = false, a = false, s = false, d = false,
        up = false, left = false, down = false, right = false,
    }

    local function mapKey(keyCode)
        if keyCode == Enum.KeyCode.W then return "w"
        elseif keyCode == Enum.KeyCode.A then return "a"
        elseif keyCode == Enum.KeyCode.S then return "s"
        elseif keyCode == Enum.KeyCode.D then return "d"
        elseif keyCode == Enum.KeyCode.Up then return "up"
        elseif keyCode == Enum.KeyCode.Left then return "left"
        elseif keyCode == Enum.KeyCode.Down then return "down"
        elseif keyCode == Enum.KeyCode.Right then return "right"
        end
        return nil
    end

    local conexaoInputBegan = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        local k = mapKey(input.KeyCode)
        if k then teclas[k] = true end
    end)

    local conexaoInputEnded = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        local k = mapKey(input.KeyCode)
        if k then teclas[k] = false end
    end)

    -- checa se um quadrado (px,py,tam) toca em alguma parede
    local function tocaParede(px, py, tam)
        local metade = tam / 2
        local esquerda, direita = px - metade, px + metade
        local topo, base = py - metade, py + metade

        for _, p in ipairs(paredes) do
            local pEsq, pDir = p.x, p.x + p.size
            local pTopo, pBase = p.y, p.y + p.size
            if esquerda < pDir and direita > pEsq and topo < pBase and base > pTopo then
                return true
            end
        end
        return false
    end

    local function resetarMinhoca()
        posX = posInicio.x + CELL_SIZE / 2
        posY = posInicio.y + CELL_SIZE / 2
        minhoca.Position = UDim2.new(0, posX, 0, posY)
        TweenService:Create(minhocaStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255, 60, 60), Thickness = 4}):Play()
        task.delay(0.3, function()
            if minhocaStroke.Parent then
                TweenService:Create(minhocaStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(40, 100, 30), Thickness = 2}):Play()
            end
        end)
    end

    local labirintoConcluido = false

    local conexaoHeartbeat
    conexaoHeartbeat = RunService.Heartbeat:Connect(function(dt)
        if labirintoConcluido then return end

        local dx, dy = 0, 0
        if teclas.w or teclas.up then dy -= 1 end
        if teclas.s or teclas.down then dy += 1 end
        if teclas.a or teclas.left then dx -= 1 end
        if teclas.d or teclas.right then dx += 1 end

        if dx ~= 0 or dy ~= 0 then
            local comprimento = math.sqrt(dx * dx + dy * dy)
            dx = (dx / comprimento) * velocidade * dt
            dy = (dy / comprimento) * velocidade * dt

            local novoX = math.clamp(posX + dx, CELL_SIZE * 0.35, larguraMapa - CELL_SIZE * 0.35)
            local novoY = math.clamp(posY + dy, CELL_SIZE * 0.35, alturaMapa - CELL_SIZE * 0.35)

            if tocaParede(novoX, novoY, minhocaSize) then
                labirintoConcluido = true -- trava por um instante pra não resetar em loop
                resetarMinhoca()
                task.delay(0.05, function() labirintoConcluido = false end)
            else
                posX, posY = novoX, novoY
                minhoca.Position = UDim2.new(0, posX, 0, posY)
            end
        end

        -- Chegou no fim?
        local distX = math.abs(posX - (posFim.x + CELL_SIZE / 2))
        local distY = math.abs(posY - (posFim.y + CELL_SIZE / 2))
        if distX < CELL_SIZE * 0.5 and distY < CELL_SIZE * 0.5 then
            labirintoConcluido = true
            rodandoLab = false
            conexaoHeartbeat:Disconnect()
            conexaoInputBegan:Disconnect()
            conexaoInputEnded:Disconnect()
            guiLab:Destroy()
            abrirJogoFrutas()
        end
    end)
end

----------------------------------------------------------------
-- LÓGICA DE VALIDAÇÃO DA KEY (dispara o labirinto ao acertar)
----------------------------------------------------------------
local function verificarKey()
    local textoDigitado = inputBox.Text:lower():gsub("%s+", "") -- remove espaços e deixa minúsculo

    if textoDigitado == RESPOSTA_CORRETA then
        erroLabel.Visible = false
        ativoKeyGui = false
        screenGui:Destroy()
        abrirLabirinto()
    else
        shakeFrame(frame, erroLabel)
    end
end

botao.MouseButton1Click:Connect(verificarKey)

inputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        verificarKey()
    end
end)
