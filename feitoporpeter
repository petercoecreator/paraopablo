-- FUNÇÕES: travar mouse / esconder CoreGui / bloquear ESC
----------------------------------------------------------------
local ESC_ACTION_NAME = "BloquearEscPeter"

local function travarTela()
    -- Trava o mouse no centro e some com o cursor
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false

    -- Esconde TODA a interface padrão do Roblox (chat, mochila, playerlist, etc.)
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
    end)

    -- Bloqueia o menu do ESC (ele simplesmente não abre mais nada)
    ContextActionService:BindActionAtPriority(
        ESC_ACTION_NAME,
        function()
            return Enum.ContextActionResult.Sink
        end,
        false,
        Enum.ContextActionPriority.High.Value,
        Enum.KeyCode.Escape
    )
end

local function destravarTela()
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true

    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
    end)

    ContextActionService:UnbindAction(ESC_ACTION_NAME)
end

----------------------------------------------------------------
-- FUNÇÃO: animação de erro (shake na janela) - genérica, recebe o frame alvo
----------------------------------------------------------------
local function shakeFrame(alvoFrame, alvoErroLabel)
    if alvoErroLabel then
        alvoErroLabel.Visible = true
    end
    local posOriginal = alvoFrame.Position
    for i = 1, 4 do
        local offset = (i % 2 == 0) and 10 or -10
        TweenService:Create(alvoFrame, TweenInfo.new(0.05), {
            Position = posOriginal + UDim2.new(0, offset, 0, 0)
        }):Play()
        task.wait(0.05)
    end
    TweenService:Create(alvoFrame, TweenInfo.new(0.05), {Position = posOriginal}):Play()
end

----------------------------------------------------------------
-- FUNÇÃO: animação BOMBÁSTICA de sucesso (mensagem final + música)
----------------------------------------------------------------
local function animacaoSucesso()
    -- Trava mouse, esconde CoreGui e bloqueia o ESC
    travarTela()

    local screenGuiFinal = Instance.new("ScreenGui")
    screenGuiFinal.Name = "PeterFinalGui"
    screenGuiFinal.ResetOnSpawn = false
    screenGuiFinal.IgnoreGuiInset = true
    screenGuiFinal.DisplayOrder = 999
    screenGuiFinal.Parent = playerGui

    -- 2) Flash branco na tela inteira
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flash.BackgroundTransparency = 0
    flash.ZIndex = 5
    flash.Parent = screenGuiFinal

    TweenService:Create(flash, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
        BackgroundTransparency = 1
    }):Play()
    task.wait(0.6)
    flash:Destroy()

    -- 3) Frame final para a mensagem (fundo 100% OPACO, o jogo não aparece mais atrás)
    local finalFrame = Instance.new("Frame")
    finalFrame.Size = UDim2.new(1, 0, 1, 0)
    finalFrame.BackgroundTransparency = 0
    finalFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
    finalFrame.ZIndex = 4
    finalFrame.ClipsDescendants = true
    finalFrame.Parent = screenGuiFinal

    -- 3.1) EFEITOS PIKASSS: formas coloridas girando/piscando/voando atrás da mensagem
    local ativo = true
    finalFrame.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            ativo = false
        end
    end)

    -- Fundo pulsando em arco-íris (cobre tudo, garante que não dá pra ver o jogo)
    task.spawn(function()
        local hueFundo = 0
        while ativo and finalFrame.Parent do
            hueFundo = (hueFundo + 0.004) % 1
            finalFrame.BackgroundColor3 = Color3.fromHSV(hueFundo, 0.55, 0.25)
            task.wait(0.03)
        end
    end)

    -- Formas voadoras/girando (efeito rave / pikas)
    local formas = {}
    for i = 1, 14 do
        local forma = Instance.new("Frame")
        forma.Size = UDim2.new(0, math.random(40, 140), 0, math.random(40, 140))
        forma.Position = UDim2.new(math.random(), 0, math.random(), 0)
        forma.AnchorPoint = Vector2.new(0.5, 0.5)
        forma.BackgroundColor3 = Color3.fromHSV(math.random(), 1, 1)
        forma.BackgroundTransparency = 0.25
        forma.ZIndex = 3
        forma.Parent = finalFrame

        local formaCorner = Instance.new("UICorner")
        formaCorner.CornerRadius = (i % 2 == 0) and UDim.new(1, 0) or UDim.new(0, 12)
        formaCorner.Parent = forma

        table.insert(formas, forma)
    end

    for _, forma in ipairs(formas) do
        task.spawn(function()
            while ativo and forma.Parent do
                local novaPos = UDim2.new(math.random(), 0, math.random(), 0)
                local novaRot = math.random(-360, 360)
                local novaCor = Color3.fromHSV(math.random(), 1, 1)

                local tween = TweenService:Create(forma, TweenInfo.new(math.random(8, 20) / 10, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                    Position = novaPos,
                    Rotation = novaRot,
                    BackgroundColor3 = novaCor,
                })
                tween:Play()
                tween.Completed:Wait()
            end
        end)
    end

    -- Flashes rápidos de cor por cima de tudo (efeito estroboscópico leve)
    task.spawn(function()
        while ativo and finalFrame.Parent do
            local strobe = Instance.new("Frame")
            strobe.Size = UDim2.new(1, 0, 1, 0)
            strobe.BackgroundColor3 = Color3.fromHSV(math.random(), 1, 1)
            strobe.BackgroundTransparency = 0.85
            strobe.ZIndex = 4
            strobe.Parent = finalFrame

            TweenService:Create(strobe, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
            task.wait(0.15)
            strobe:Destroy()
            task.wait(math.random(2, 5) / 10)
        end
    end)

    local mensagemLabel = Instance.new("TextLabel")
    mensagemLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    mensagemLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
    mensagemLabel.Size = UDim2.new(0, 0, 0, 0)
    mensagemLabel.BackgroundTransparency = 1
    mensagemLabel.Text = ""
    mensagemLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    mensagemLabel.Font = Enum.Font.GothamBlack
    mensagemLabel.TextWrapped = true
    mensagemLabel.TextScaled = true
    mensagemLabel.ZIndex = 10 -- sempre acima dos efeitos PIKASSS
    mensagemLabel.Parent = finalFrame

    local outline = Instance.new("UIStroke")
    outline.Color = Color3.fromRGB(0, 0, 0)
    outline.Thickness = 3
    outline.Parent = mensagemLabel

    -- Fundo próprio atrás do texto (garante leitura mesmo com os efeitos loucos passando)
    local caixaTexto = Instance.new("Frame")
    caixaTexto.Size = UDim2.new(1, 40, 1, 40)
    caixaTexto.Position = UDim2.new(0.5, 0, 0.5, 0)
    caixaTexto.AnchorPoint = Vector2.new(0.5, 0.5)
    caixaTexto.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    caixaTexto.BackgroundTransparency = 0.4
    caixaTexto.ZIndex = 9
    caixaTexto.Parent = mensagemLabel

    local caixaCorner = Instance.new("UICorner")
    caixaCorner.CornerRadius = UDim.new(0, 20)
    caixaCorner.Parent = caixaTexto

    -- Painel entra crescendo
    TweenService:Create(mensagemLabel, TweenInfo.new(0.7, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
        Size = UDim2.new(0.85, 0, 0.5, 0)
    }):Play()
    task.wait(0.4)

    -- 4) Efeito "máquina de escrever" pra escrever a mensagem
    local textoAtual = ""
    for i = 1, #MENSAGEM_FINAL do
        textoAtual = MENSAGEM_FINAL:sub(1, i)
        mensagemLabel.Text = textoAtual
        task.wait(0.02)
    end

    -- 5) Toca o som ID 106412079335663
    local som = Instance.new("Sound")
    som.Name = "PedradaSound"
    som.SoundId = SOUND_ID
    som.Volume = 1
    som.Looped = false
    som.Parent = SoundService

    -- Já entra tocando 25 segundos adiantado
    som.TimePosition = 25
    som:Play()

    -- 6) Efeito contínuo de cor piscando (rainbow) + leve tremor no texto enquanto o som toca
    task.spawn(function()
        local hue = 0
        while mensagemLabel.Parent do
            hue = (hue + 0.01) % 1
            mensagemLabel.TextColor3 = Color3.fromHSV(hue, 0.8, 1)
            task.wait(0.03)
        end
    end)

    task.spawn(function()
        local posOriginal = mensagemLabel.Position
        while mensagemLabel.Parent do
            local offsetX = math.random(-4, 4)
            local offsetY = math.random(-4, 4)
            mensagemLabel.Position = posOriginal + UDim2.new(0, offsetX, 0, offsetY)
            task.wait(0.05)
        end
    end)

    -- 7) Zoom pulsante contínuo (efeito "vivo")
    task.spawn(function()
        while mensagemLabel.Parent do
            TweenService:Create(mensagemLabel, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0.88, 0, 0.53, 0)
            }):Play()
            task.wait(0.8)
            TweenService:Create(mensagemLabel, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
                Size = UDim2.new(0.85, 0, 0.5, 0)
            }):Play()
            task.wait(0.8)
        end
    end)

    -- Remove tudo automaticamente quando o som terminar
    som.Ended:Connect(function()
        task.wait(2) -- deixa a mensagem mais um pouco na tela depois do som acabar
        finalFrame:Destroy()
        som:Destroy()
        destravarTela() -- devolve o controle do mouse e a interface do Roblox
    end)
end

